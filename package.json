{
  "name": "roadwatch-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --platform=node --format=esm --packages=external --bundle --outfile=server.js",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --packages=external --bundle --outfile=server.js",
    "preview": "vite preview",
    "start": "node server.js",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'server.js'].forEach(p => fs.rmSync(p, {recursive: true, force: true}));\"",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "4.17.25",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "dotenv": "17.4.2",
    "esbuild": "0.25.12",
    "express": "4.22.3",
    "firebase": "13.1.0",
    "jiti": "2.4.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "leaflet": "1.9.4",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rolldown": "1.2.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
